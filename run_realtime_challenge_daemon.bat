@echo off
chcp 65001 > nul
set PYTHONIOENCODING=utf-8
title 🤖 [AI 500M 챌린지] 장중 실시간 매매 상주 및 매도 즉시 유튜브 업로드 데몬

echo ======================================================================
echo   🤖 [AI 500만원 주식 굴리기] 장중 실시간 매매 상주 데몬 가동
echo ======================================================================
echo.
echo [1] 08:55 ~ 09:00: 장 시작 전 대기 및 NXT 프리마켓 1위 주도주 로드
echo [2] 09:00 ~ 09:05: 시초가 갭 덫 방어 (5분 쿨다운 관망)
echo [3] 09:05 ~ 09:40: [제1 골든타임] 1분봉 3·5·20 눌림목 실시간 가상 매수
echo [4] 🎯 목표가(+3%%) 도달 즉시 전량 매도 체결
echo [5] ⚡ [매도 직후 즉각 배포] 60FPS 쇼츠 즉시 렌더링 ➔ 유튜브 실시간 업로드!
echo [6] 📲 스마트폰 텔레그램으로 완료 링크 즉시 발송
echo.
echo ======================================================================
echo   장중 실시간 감시를 시작합니다. (창을 닫지 마세요)
echo ======================================================================
echo.

cd /d "%~dp0"
call .venv\Scripts\activate.bat

python execution\realtime_challenge_daemon.py --upload --privacy public

if errorlevel 1 (
    echo.
    echo ❌ [오류 발생] 데몬 실행 도중 오류가 발생했습니다.
    pause
    exit /b 1
)

echo.
echo ======================================================================
echo 🎉 [완료] 금일 장 마감 및 실시간 매매 쇼츠 업로드가 모두 완료되었습니다!
echo ======================================================================
timeout /t 10

